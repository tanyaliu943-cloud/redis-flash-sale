# Optional for local use. Leave unset to connect to localhost:6379.
# For hosted Redis, put the provider's TLS URL in your host's secret settings,
# never commit the actual credential.
# REDIS_URL=rediss://default:replace-this-with-your-password@your-redis-host:6379/0

# Optional local connection settings when REDIS_URL is not set:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
